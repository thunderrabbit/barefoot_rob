RewriteEngine On
RewriteRule ^journal\.pl$ /journal/journal.pl [L,QSA]

# Short links printed on physical things (typed by hand, so case-insensitive
# with an optional trailing slash). One hop straight to the page instead of
# the /en/ + trailing-slash + alias-stub chain. 302 so a target can change
# later without browsers caching the old one; QSD drops any query string.
RewriteRule ^fine/?$ https://www.robnugen.com/en/books/im-fine/ [NC,QSD,R=302,L]
RewriteRule ^ibo/?$ https://www.robnugen.com/en/offerings/inbox-overflow/ [NC,QSD,R=302,L]

# Since 2021-09-20 every page lives under /en/ or /ja/, but years of links in
# the wild (and URLs printed on physical things) use the pre-2021 bare form.
# Hugo used to render root-level alias redirect stubs for those; a Hugo
# upgrade stopped that (bare URLs 404'd from ~May 2026), so the server owns
# the redirect now: any request that is not language-prefixed and does not
# resolve to a real file or a directory with an index gets one hop to /en/.
# (Index-less root dirs like /art/ and /blog/ exist only to hold url-pinned
# pages — redirecting beats serving an Apache directory listing.)
# /missing.html is DreamHost's ErrorDocument 404 target: rewriting it turns
# every 404 into a redirect loop, so it is excluded, as are the Perl journal
# app and ACME challenges.
RewriteCond %{REQUEST_URI} !^/(en|ja|journal)(/|$)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{REQUEST_URI} !^/missing\.html$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^(.*)$ /en/$1 [R=301,L]
