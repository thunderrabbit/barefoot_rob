#!/bin/sh
# Refuse to commit if the rendered site has newly broken internal links.
# Skipped when no site-affecting files are staged, so non-content commits
# stay instant. Note: the check builds from the WORKING TREE, so an
# unstaged broken edit can also trip it — tripwire, not proof.
# One-time activation on each machine:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
if git diff --cached --name-only | grep -qE '^(content/|layouts/|static/|themes/|config\.toml)'; then
    exec perl check_links.pl
fi
exit 0
